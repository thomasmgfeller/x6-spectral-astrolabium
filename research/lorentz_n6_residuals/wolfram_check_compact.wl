input = ImportString[inputJSON, "RawJSON"];
ClearAll[graph, feature, base, pairResult, strictQ];
graph[c_] := Graph[Range[Length[c]], DirectedEdge @@@ Position[c, 1]];
strictQ[c_] := MatrixQ[c, (# === 0 || # === 1)&] && Tr[c] == 0 &&
 And @@ Flatten[MapThread[(#1 == 0 || #2 == 1)&, {c.c, c}, 2]];
feature[c_] := Module[{n = Length[c], s, a, k, d},
 s = c + Transpose[c]; a = c - Transpose[c]; k = s.a - a.s;
 d = Sort[Transpose[{Total[c], Total[Transpose[c]]}]];
 <|"n" -> n,
 "polynomials_S_A_K" -> (Reverse[CoefficientList[CharacteristicPolynomial[#, t], t]]& /@ {s,a,k}),
 "degree_pairs" -> d,
 "minimal_maximal_isolated" -> {Count[d, {0,_}], Count[d, {_,0}], Count[d, {0,0}]},
 "W_future" -> Total[Binomial[#[[2]],2]& /@ d],
 "W_past" -> Total[Binomial[#[[1]],2]& /@ d],
 "edges" -> Total[Flatten[c]],
 "height_at_most_two" -> (Total[Flatten[c.c]] == 0),
 "connected" -> ConnectedGraphQ[UndirectedGraph[graph[c]]]|>
];
matrices = Association[Map[(#["id"] -> #["causal_matrix"])&, input["records"]]];
records = Map[feature, matrices];
base[f_] := {f["n"], f["polynomials_S_A_K"], Take[f["minimal_maximal_isolated"],2]};
pairResult[ids_] := Module[{a=records[ids[[1]]], b=records[ids[[2]]], ca=matrices[ids[[1]]], cb=matrices[ids[[2]]]},
 <|"ids"->ids, "same_F0"->SameQ[base[a],base[b]],
 "same_D"->SameQ[a["degree_pairs"],b["degree_pairs"]],
 "same_W_future"->SameQ[a["W_future"],b["W_future"]],
 "same_W_past"->SameQ[a["W_past"],b["W_past"]],
 "isomorphic"->IsomorphicGraphQ[graph[ca],graph[cb]],
 "dual_isomorphic"->IsomorphicGraphQ[graph[Transpose[ca]],graph[cb]]|>
];
pairs = pairResult /@ Join[input["primary_pairs"],input["scope_pairs"]];
checks = <|
 "strict_transitive_inputs" -> And @@ (strictQ /@ Values[matrices]),
 "K_normalization" -> And @@ Map[Function[c, With[{s=c+Transpose[c],a=c-Transpose[c]}, s.a-a.s === 2(Transpose[c].c-c.Transpose[c])]], Values[matrices]],
 "all_primary_same_F0_nonisomorphic_separated_D_and_W_future" -> And @@ Map[(#["same_F0"] && !#["isomorphic"] && !#["same_D"] && !#["same_W_future"])&, Take[pairs,4]],
 "n7_future_only_collision_separated_by_past" -> With[{f=pairs[[5]]}, f["same_F0"] && !f["isomorphic"] && f["same_W_future"] && !f["same_W_past"]],
 "n8_D_and_both_moments_fail_connected_duals" -> With[{f=pairs[[6]]}, f["same_F0"] && !f["isomorphic"] && f["dual_isomorphic"] && f["same_D"] && f["same_W_future"] && f["same_W_past"] && records["n8-degree-a"]["connected"] && records["n8-degree-b"]["connected"]],
 "reverse_label_invariance" -> And @@ Map[Function[c, feature[Reverse[Reverse /@ c]] === feature[c]], Values[matrices]]
|>;
ExportString[<|"schema"->"x6.lorentz-wolfram/1", "wolfram_version"->$Version,
 "inputs_sha256"->Hash[inputJSON,"SHA256","HexString"],
 "sha256_abc"->Hash["abc","SHA256","HexString"],
 "records"->records, "pairs"->pairs, "checks"->checks|>, "RawJSON", "Compact" -> True]
