{
  "type": "object",
  "properties": {
    "schema": {
      "const": "X6-PF-EXECUTION-REQUEST"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "enum": [
        "LOCAL_JS",
        "PYTHON",
        "WASM",
        "WEBGPU",
        "EXTERNAL_SOLVER"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "precision": {
      "enum": [
        "float32",
        "float64"
      ]
    },
    "implementation": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "runtime_fingerprint": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "platform",
        "architecture",
        "runtime",
        "runtime_version",
        "device",
        "dependency_lock"
      ],
      "additionalProperties": false
    },
    "resource_enforcement": {
      "type": "object",
      "properties": {
        "wall_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory_limit_mib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evaluation_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "wall_timeout_seconds",
        "memory_limit_mib",
        "evaluation_limit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "contract_sha256",
    "target",
    "profile_id",
    "precision",
    "implementation",
    "runtime_fingerprint",
    "resource_enforcement"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x6:pf:execution-request:0.2.0"
}
