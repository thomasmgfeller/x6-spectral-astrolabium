    "preservation_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reference_amplitude": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reference_sample": {
            "type": "integer",
            "minimum": 0
          },
          "reference_kind": {
            "enum": [
              "DESIGN_ONLY",
              "SYNTHETIC_FLOAT32"
            ]
          },
          "sample_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "peak_window": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "reference": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
